#
# The types of the fixtures the run serves, carried here rather than
# taken from the machine so that the reference reports the very same
# fields whether it was started out of an image or out of the binary
# the machine happens to have installed on it.

types {
    text/html                             html htm;
    text/plain                            txt;
    text/css                              css;
    application/javascript                js;
    image/png                             png;
    image/svg+xml                         svg;
    application/octet-stream              bin;
}
